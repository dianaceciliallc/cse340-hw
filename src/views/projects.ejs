<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    
    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <strong><%= new Date(project.project_date).toLocaleDateString() %></strong>: 
                    <%= project.title %> (<%= project.organization_name %>)
                    <p><%= project.description %></p>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No service projects available at this time.</p>
    <% } %>
</main>
<%- include('partials/footer') %>